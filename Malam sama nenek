local function connect(signal, fn)
 local c = signal:Connect(fn); table.insert(connections,c); return c
end
local function cleanup()
 alive = false
 for _,c in ipairs(connections) do pcall(function() c:Disconnect() end) end
 for obj,h in pairs(highlights) do pcall(function() h:Destroy() end) end
 table.clear(highlights)
 for part,old in pairs(oldCollisions) do if part and part.Parent then pcall(function() part.CanCollide=old end) end end
 local ch=LP.Character; local hum=ch and ch:FindFirstChildOfClass("Humanoid")
 if hum then pcall(function() hum.WalkSpeed=16 end) end
end
getgenv().ZOYA_CLEANUP = cleanup

