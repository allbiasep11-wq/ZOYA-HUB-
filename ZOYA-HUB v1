local lastWarning = 0

-- Auto scan and feature loop
task.spawn(function()
    while running do
        pcall(scanObjects)
        pcall(scanPlayers)

        local char = LP.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum = char and char:FindFirstChildOfClass("Humanoid")

        if hum and speedEnabled then
            hum.WalkSpeed = walkSpeedValue
        end

        if char and noclip then
            for _,part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    part.CanCollide = false
                end
            end
        end

        local opahNear = false
        if root then
            for _,obj in ipairs(Workspace:GetDescendants()) do
                if matches(obj,{"opah"}) then
                    local part = obj:IsA("Model") and
                        (obj:FindFirstChild("HumanoidRootPart")
                        or obj:FindFirstChildWhichIsA("BasePart"))
                        or (obj:IsA("BasePart") and obj)

                    if part and (part.Position-root.Position).Magnitude < 35 then
                        opahNear = true
                        break
                    end
                end
            end
        end

        warningLabel.Visible = opahNear
        if opahNear and tick()-lastWarning > 4 then
            lastWarning = tick()
            -- Isi SoundId sendiri jika ingin alarm:
            -- SoundId = "rbxassetid://ID_AUDIO"
        end

        if autoKey and root then
            for _,obj in ipairs(Workspace:GetDescendants()) do
                if matches(obj,{"key","kunci"}) then
                    local part = obj:IsA("Model") and
                        obj:FindFirstChildWhichIsA("BasePart")
                        or (obj:IsA("BasePart") and obj)

                    if part and (part.Position-root.Position).Magnitude < 12 then
                        for _,prompt in ipairs(obj:GetDescendants()) do
                            if prompt:IsA("ProximityPrompt") then
                                pcall(function()
                                    if fireproximityprompt then
                                        fireproximityprompt(prompt)
                                    end
                                end)
                            end
                        end
                    end
                end
            end
        end

        task.wait(1)
    end
end)

