local function toggle(text, y, initial, callback)
    local state = initial or false
    local b = button(text .. " : " .. (state and "ON" or "OFF"), y, function()
        state = not state
        b.Text = text .. " : " .. (state and "ON" or "OFF")
        b.BackgroundColor3 = state and Color3.fromRGB(105,55,165)
            or Color3.fromRGB(48,34,65)
        callback(state)
    end)
    return b
end

-- ESP helpers
local function clearESP(obj)
    if highlights[obj] then
        pcall(function() highlights[obj]:Destroy() end)
        highlights[obj] = nil
    end
end

local function addESP(obj, color, title)
    if not obj or highlights[obj] then return end
    local adornee = obj
    if obj:IsA("Model") then
        if not obj:FindFirstChildWhichIsA("BasePart") then return end
    elseif not obj:IsA("BasePart") then
        return
    end

    local h = Instance.new("Highlight")
    h.Name = "ZOYA_ESP"
    h.Adornee = adornee
    h.FillColor = color
    h.OutlineColor = color
    h.FillTransparency = 0.72
    h.OutlineTransparency = 0
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Parent = Gui
    highlights[obj] = h

    if title then
        local part = obj:IsA("Model") and
            (obj:FindFirstChild("Head") or obj:FindFirstChildWhichIsA("BasePart"))
            or obj
        if part then
            local bb = Instance.new("BillboardGui")
            bb.Name = "ZOYA_TAG"
            bb.Adornee = part
            bb.Size = UDim2.fromOffset(150,25)
            bb.StudsOffset = Vector3.new(0,3,0)
            bb.AlwaysOnTop = true
            bb.Parent = h

            local t = Instance.new("TextLabel")
            t.Size = UDim2.fromScale(1,1)
            t.BackgroundTransparency = 1
            t.Text = title
            t.TextColor3 = color
            t.TextStrokeTransparency = 0
            t.Font = Enum.Font.GothamBold
            t.TextSize = 12
            t.Parent = bb
        end
    end
end

local function matches(obj, words)
    local n = string.lower(obj.Name)
    for _,word in ipairs(words) do
        if string.find(n, word, 1, true) then return true end
    end
    return false
end

local function scanObjects()
    for _,obj in ipairs(Workspace:GetDescendants()) do
        if not running then break end
        if espEnabled.Opah and matches(obj, {"opah"}) then
            addESP(obj, rainbow and Color3.fromHSV((tick()%5)/5,1,1) or selectedColor, "OPAH")
        elseif espEnabled.Key and matches(obj, {"key","kunci"}) then
            addESP(obj, Color3.fromRGB(255,220,40), "KEY")
        elseif espEnabled.Code and matches(obj, {"code","kode","note","paper"}) then
            addESP(obj, Color3.fromRGB(50,220,255), "CODE")
        end
    end
end

local function scanPlayers()
    for _,plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character then
            if espEnabled.Player then
                addESP(plr.Character, Color3.fromRGB(80,220,255), "PLAYER: "..plr.Name)
            else
                clearESP(plr.Character)
            end
        end
    end
end

