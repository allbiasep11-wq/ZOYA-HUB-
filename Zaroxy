-- ESP helpers
local function hasName(obj,words)
    local n=string.lower(obj.Name)
    for _,w in ipairs(words) do if string.find(n,w,1,true) then return true end end
    return false
end
local function targetPart(obj)
    if obj:IsA("BasePart") then return obj end
    if obj:IsA("Model") then return obj:FindFirstChild("HumanoidRootPart") or obj:FindFirstChild("Head") or obj:FindFirstChildWhichIsA("BasePart") end
end
local function clearESP(obj)
    if Highlights[obj] then pcall(function() Highlights[obj]:Destroy() end); Highlights[obj]=nil end
    if Billboards[obj] then pcall(function() Billboards[obj]:Destroy() end); Billboards[obj]=nil end
end
local function addESP(obj,color,title)
    if not obj or not obj.Parent then return end
    if not obj:IsA("Model") and not obj:IsA("BasePart") then return end
    local part=targetPart(obj); if not part then return end
    local h=Highlights[obj]
    if not h or not h.Parent then
        h=Instance.new("Highlight"); h.Name="ZOYA_V6_ESP"; h.Adornee=obj
        h.FillTransparency=State["ESP OUTLINE MODE"] and 1 or .82
        h.OutlineTransparency=.1; h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop; h.Parent=Gui
        Highlights[obj]=h
    end
    h.FillColor=color; h.OutlineColor=color
    if State["ESP NAME TAG"] or State["ESP DISTANCE"] then
        local bb=Billboards[obj]
        if not bb or not bb.Parent then
            bb=Instance.new("BillboardGui"); bb.Name="ZOYA_V6_TAG"; bb.Adornee=part
            bb.Size=UDim2.fromOffset(150,28); bb.StudsOffset=Vector3.new(0,2.7,0); bb.AlwaysOnTop=true; bb.Parent=Gui
            local label=Instance.new("TextLabel"); label.Name="Text"; label.Size=UDim2.fromScale(1,1)
            label.BackgroundTransparency=1; label.TextStrokeTransparency=.2; label.TextStrokeColor3=Color3.new(0,0,0)
            label.Font=Enum.Font.GothamBold; label.TextColor3=color; label.TextSize=State["ESP TEXT SIZE"] and 15 or 11; label.Parent=bb
            Billboards[obj]=bb
        end
        local myRoot=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        local dist=myRoot and math.floor((part.Position-myRoot.Position).Magnitude) or nil
        local text=State["ESP NAME TAG"] and title or ""
        if State["ESP DISTANCE"] and dist then text=text.." ["..dist.."m]" end
        local lbl=bb:FindFirstChild("Text")
        if lbl then
            lbl.Text=text; lbl.TextColor3=(State["ESP DISTANCE COLOR"] and dist and dist<30) and C.red or color
            lbl.TextSize=State["ESP TEXT SIZE"] and 15 or 11
        end
    elseif Billboards[obj] then
        Billboards[obj]:Destroy(); Billboards[obj]=nil
    end
end
local function scanESP()
    if not Alive then return end
    local targets={}
    local myRoot=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    for _,obj in ipairs(Workspace:GetDescendants()) do
        if not Alive then return end
        if obj:IsA("Model") or obj:IsA("BasePart") then
            local title,color=nil,nil
            if State["ESP OPAH"] and hasName(obj,{"opah"}) then title="OPAH"; color=SelectedColor
            elseif State["ESP KEY"] and hasName(obj,{"key","kunci"}) then title="KEY"; color=C.yellow
            elseif State["ESP CODE"] and hasName(obj,{"code","kode","note","paper"}) then title="CODE"; color=C.cyan end
            if title then
                local p=targetPart(obj)
                local d=(p and myRoot) and (p.Position-myRoot.Position).Magnitude or 0
                if not State["ESP MAX DISTANCE"] or d<=MaxDistance then
                    if State["RAINBOW ESP"] then color=Color3.fromHSV((tick()%5)/5,1,1) end
                    targets[obj]={color,title}
                end
            end
        end
    end
    if State["ESP PLAYER"] then
        for _,p in ipairs(Players:GetPlayers()) do
            if p~=LP and p.Character then targets[p.Character]={C.cyan,p.Name} end
