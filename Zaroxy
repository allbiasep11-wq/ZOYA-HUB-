local function New(class, props, parent)
    local o = Instance.new(class)
    for k,v in pairs(props) do o[k]=v end
    o.Parent=parent
    return o
end
local function Corner(o,r)
    local x=Instance.new("UICorner"); x.CornerRadius=UDim.new(0,r or 8); x.Parent=o
end
local function Stroke(o,color,thick)
    local x=Instance.new("UIStroke"); x.Color=color or C.accent; x.Thickness=thick or 1; x.Parent=o
    return x
end
local function Tween(o,t,p)
    local tw=game:GetService("TweenService"):Create(o,TweenInfo.new(t,Enum.EasingStyle.Quint,Enum.EasingDirection.Out),p)
    tw:Play(); return tw
end

