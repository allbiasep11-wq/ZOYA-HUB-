local function getKeyPart(obj)
    if not obj or not obj.Parent then return nil end
    if obj:IsA("BasePart") then return obj end
    if obj:IsA("Model") then
        return obj.PrimaryPart
            or obj:FindFirstChild("Handle", true)
            or obj:FindFirstChild("HumanoidRootPart", true)
            or obj:FindFirstChildWhichIsA("BasePart", true)
    end
    return nil
end

local function getPromptPart(prompt)
    local p = prompt and prompt.Parent
    if p and p:IsA("Attachment") then p = p.Parent end
    if p and p:IsA("BasePart") then return p end
    return nil
end

local function findPromptForObject(obj, objectPart)
    if not obj then return nil end
    for _, item in ipairs(obj:GetDescendants()) do
        if item:IsA("ProximityPrompt") and item.Enabled then return item end
    end
    if objectPart then
        for _, item in ipairs(Workspace:GetDescendants()) do
            if item:IsA("ProximityPrompt") and item.Enabled then
                local p = getPromptPart(item)
                if p and (p.Position - objectPart.Position).Magnitude <= 8 then
                    return item
                end
            end
        end
    end
    return nil
end

local function findNearestNamed(root, words, completed)
    local best, bestPart, bestDistance = nil, nil, math.huge
    local isKeySearch = words and (table.find(words, "key") or table.find(words, "kunci") or table.find(words, "gembok"))
    local function validCandidate(obj)
        local name = string.lower(obj.Name)
        if isKeySearch then
            -- Avoid false positives such as Monkey/Cat or safe-zone props.
            if string.find(name, "monkey", 1, true) or string.find(name, "kucing", 1, true)
                or string.find(name, "cat", 1, true) or string.find(name, "safe", 1, true)
                or string.find(name, "door", 1, true) or string.find(name, "pintu", 1, true) then return false end
            return string.find(name, "key", 1, true) ~= nil
                or string.find(name, "kunci", 1, true) ~= nil
                or string.find(name, "gembok", 1, true) ~= nil
        end
        return hasName(obj, words)
    end
    for _, obj in ipairs(Workspace:GetDescendants()) do
        local nestedInMatchingModel = false
        if obj:IsA("BasePart") then
            local ancestor = obj.Parent
            while ancestor and ancestor ~= Workspace do
                if ancestor:IsA("Model") and hasName(ancestor, words) then
                    nestedInMatchingModel = true
                    break
                end
                ancestor = ancestor.Parent
            end
        end
        if (obj:IsA("Model") or obj:IsA("BasePart"))
            and not nestedInMatchingModel
            and validCandidate(obj) and not (completed and completed[obj]) then
            local part = getKeyPart(obj)
            if part and part:IsDescendantOf(Workspace) then
                local distance = (part.Position - root.Position).Magnitude
                if distance < bestDistance then
                    best, bestPart, bestDistance = obj, part, distance
                end
            end
        end
    end
    return best, bestPart, bestDistance
end

local function teleportNear(root, hum, part, height)
    if not root or not part or not part.Parent then return false end
    local destination = CFrame.new(part.Position + Vector3.new(0, height or 3, 0))
    local start = root.CFrame
    local distance = (destination.Position - start.Position).Magnitude
    local duration = math.clamp(distance / math.max(AutoKeyFlightSpeed, 15), 0.25, 2.5)
    local began = tick()
    pcall(function() hum:ChangeState(Enum.HumanoidStateType.Physics) end)
    while Alive and root.Parent and part.Parent do
        local alpha = math.clamp((tick() - began) / duration, 0, 1)
        local eased = alpha * alpha * (3 - 2 * alpha)
        pcall(function()
            root.CFrame = start:Lerp(destination, eased)
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end)
        if alpha >= 1 then break end
        RunService.Heartbeat:Wait()
    end
    return root.Parent ~= nil
end

local function activatePrompt(prompt)
    if not prompt or not prompt.Parent or not prompt.Enabled then return false end
    local ok = pcall(function()
        if typeof(fireproximityprompt) == "function" then
            fireproximityprompt(prompt)
        else
            prompt:InputHoldBegin()
            task.delay(math.max(prompt.HoldDuration, 0.1), function()
                pcall(function()
                    if prompt and prompt.Parent then prompt:InputHoldEnd() end
                end)
            end)
        end
    end)
    return ok
end

local function stopKeyFlight()
    local char = LP.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
    end
    AutoKeyTarget = nil
    AutoKeyPhase = "IDLE"
    AutoHasKey = false
    table.clear(AutoKeyCompleted)
end

local function runAutoWin()
    if not Alive then return end
    local char = LP.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end

    if not State["AUTO WIN"] then
        if AutoKeyPhase ~= "IDLE" then stopKeyFlight() end
        return
    end

    -- Collect keys one by one. A key is marked complete only after the
    -- prompt is disabled or the target disappears from Workspace.
    local keyObject, keyPart = nil, nil
    if not AutoHasKey then
        keyObject, keyPart = findNearestNamed(root, {"key", "kunci", "gembok"}, AutoKeyCompleted)
    end
    if keyObject and keyPart then
        AutoKeyPhase = "COLLECT_KEYS"
        AutoKeyTarget = keyObject

        if tick() - AutoKeyActionAt >= 1.25 then
            AutoKeyActionAt = tick()

            -- Move to the actual interaction point before firing the prompt.
            local prompt = findPromptForObject(keyObject, keyPart)
            local promptPart = getPromptPart(prompt)
            local destination = promptPart or keyPart
            teleportNear(root, hum, destination, 2.2)
            task.wait(0.35)

            -- Re-find after teleport in case the game streamed or replaced it.
            if keyObject and keyObject.Parent then
                prompt = findPromptForObject(keyObject, keyPart)
            end

            if prompt and prompt.Parent and prompt.Enabled then
                local activated = activatePrompt(prompt)
                task.wait(math.max(0.65, (tonumber(prompt.HoldDuration) or 0) + 0.25))

                local collected = (not keyObject.Parent)
                    or (not keyPart.Parent)
                    or (not prompt.Parent)
                    or (prompt.Parent and not prompt.Enabled)

                if collected then
                    AutoKeyCompleted[keyObject] = true
                    AutoHasKey = true
                    Toast("AUTO WIN: Key berhasil diambil: " .. keyObject.Name, C.green)
                else
                    -- Do not skip an uncollected key. Retry it after cooldown.
                    Toast("AUTO WIN: Key belum terambil; mencoba lagi", C.yellow)
                    if not activated then AutoKeyActionAt = tick() - 0.7 end
                end
            else
                -- Some games use touch-based pickup instead of ProximityPrompt.
                -- Stay at the key briefly and only advance if it disappears.
                task.wait(0.45)
                if not keyObject.Parent or not keyPart.Parent then
                    AutoKeyCompleted[keyObject] = true
                    AutoHasKey = true
                    Toast("AUTO WIN: Key terambil", C.green)
                else
                    Toast("AUTO WIN: prompt Key tidak ditemukan; Key tidak dilewati", C.yellow)
                end
            end
        end
        return
    end

    -- Never head to a door from the safe zone: require a confirmed key first.
    if not AutoHasKey then
        AutoKeyPhase = "WAIT_FOR_KEY"
        if tick() - AutoKeyNoticeAt > 5 then
            AutoKeyNoticeAt = tick()
            Toast("AUTO WIN: menunggu kunci/gembok; pintu belum dituju", C.yellow)
        end
        return
    end
    AutoKeyPhase = "GO_TO_DOOR"
    local doorObject, doorPart = findNearestNamed(root, {"door", "pintu"}, nil)
    if doorObject and doorPart then
        AutoKeyTarget = doorObject
        if tick() - AutoKeyActionAt >= 1.5 then
            AutoKeyActionAt = tick()
            local prompt = findPromptForObject(doorObject, doorPart)
            local promptPart = getPromptPart(prompt)
            teleportNear(root, hum, promptPart or doorPart, 2.2)
            task.wait(0.35)
            prompt = findPromptForObject(doorObject, doorPart)

            if prompt and prompt.Parent and prompt.Enabled then
                activatePrompt(prompt)
                task.wait(math.max(0.7, (tonumber(prompt.HoldDuration) or 0) + 0.3))
                if not prompt.Parent or not prompt.Enabled or not doorObject.Parent then
                    Toast("AUTO WIN: pintu terbuka; mencari kunci berikutnya", C.green)
                    AutoKeyPhase = "DOOR_ACTION"
                    table.clear(AutoKeyCompleted)
                    AutoHasKey = false
                    AutoKeyActionAt = tick() + 1.0
                else
                    Toast("AUTO WIN: sudah di pintu, tetapi pintu belum terbuka", C.yellow)
                end
            else
                Toast("AUTO WIN: prompt pintu tidak ditemukan", C.yellow)
            end
        end
    elseif tick() - AutoKeyNoticeAt > 5 then
        AutoKeyNoticeAt = tick()
        Toast("AUTO WIN: Key terdeteksi selesai; Door/Pintu belum ditemukan", C.yellow)
    end
end

