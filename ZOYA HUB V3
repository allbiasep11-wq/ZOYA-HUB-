local function rootOf(model)
    if not model then return nil end
    return model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
end
local function kindOf(obj)
    local name=obj.Name:lower()
    if name:find("opah") or name:find("nenek") then return "Opah" end
    if name:find("key") or name:find("kunci") then return "Key" end
    if name:find("code") or name:find("kode") or name:find("password") then return "Code" end
    return nil
end
local function clearHighlight(obj)
    if highlights[obj] then pcall(function() highlights[obj]:Destroy() end); highlights[obj]=nil end
end
local function addHighlight(obj, kind)
    if highlights[obj] or not obj:IsDescendantOf(Workspace) then return end
    local target=obj
    if not (obj:IsA("Model") or obj:IsA("BasePart")) then return end
    local h=Instance.new("Highlight"); h.Name="ZOYA_V2_ESP"; h.Adornee=target
    h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop; h.FillTransparency=.78; h.OutlineTransparency=0
    local c=(kind=="Opah" and opahColor) or (kind=="Player" and playerColor) or (kind=="Key" and COLORS.Yellow) or COLORS.Cyan
    h.FillColor=c; h.OutlineColor=c; h.Parent=Workspace; highlights[obj]=h
end
local function playAlert()
    if os.clock()-lastSound<4 then return end
    lastSound=os.clock()
    pcall(function()
        local s=Instance.new("Sound"); s.SoundId="rbxassetid://9118823101"; s.Volume=.7; s.Parent=Workspace
        s:Play(); Debris:AddItem(s,4)
    end)
    notify("⚠ OPAH DEKAT! Opah terdeteksi di sekitar kamu.")
end

local scanTimer=0
local heartbeatConn=RunService.Heartbeat:Connect(function(dt)
    if not alive then return end
    scanTimer+=dt
    if scanTimer<1 then return end
    scanTimer=0
    local myRoot=rootOf(LP.Character)
    local near=false
    for _,obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("BasePart") then
            local kind=kindOf(obj)
            if kind and esp[kind] then addHighlight(obj,kind) elseif highlights[obj] and kind then clearHighlight(obj) end
            if kind=="Opah" and myRoot and alertOn then
                local targetRoot=rootOf(obj:IsA("Model") and obj or obj:FindFirstAncestorOfClass("Model"))
                if targetRoot and (targetRoot.Position-myRoot.Position).Magnitude<=35 then near=true end
            end
        end
    end
    if esp.Player then
        for _,p in ipairs(Players:GetPlayers()) do
            if p~=LP and p.Character then addHighlight(p.Character,"Player") end
        end
    else
        for obj in pairs(highlights) do
            if obj:IsA("Model") and Players:GetPlayerFromCharacter(obj) then clearHighlight(obj) end
        end
    end
    if rainbow then
        opahColor=Color3.fromHSV((os.clock()%5)/5,1,1)
        for obj,h in pairs(highlights) do if kindOf(obj)=="Opah" then h.FillColor=opahColor; h.OutlineColor=opahColor end end
    end
    if near and not alertWasNear then playAlert() end
    alertWasNear=near
    setBanner(near and alertOn)
end)

local stepConn=RunService.Stepped:Connect(function()
    if not alive then return end
    local char=LP.Character
    if char then
        for _,p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then
                if noclip then
                    if oldCollisions[p]==nil then oldCollisions[p]=p.CanCollide end
                    p.CanCollide=false
                elseif oldCollisions[p]~=nil then p.CanCollide=oldCollisions[p]; oldCollisions[p]=nil end
            end
        end
        local hum=char:FindFirstChildOfClass("Humanoid")
        if hum then
            if speedOn then
                if not originalSpeed then originalSpeed=hum.WalkSpeed end
                hum.WalkSpeed=speedValue
            elseif originalSpeed then hum.WalkSpeed=originalSpeed; originalSpeed=nil end
        end
    end
end)

local autoTimer=0
local autoConn=RunService.Heartbeat:Connect(function(dt)
    if not alive or not autoKey or typeof(fireproximityprompt)~="function" then return end
    autoTimer+=dt; if autoTimer<.5 then return end; autoTimer=0
    for _,v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("ProximityPrompt") then
            local n=(v.Parent and v.Parent.Name or ""):lower()
            if n:find("key") or n:find("kunci") then pcall(fireproximityprompt,v) end
        end
    end
end)

local function cleanup()
    alive=false
    heartbeatConn:Disconnect(); stepConn:Disconnect(); autoConn:Disconnect()
    for obj in pairs(highlights) do clearHighlight(obj) end
    for part,oldValue in pairs(oldCollisions) do pcall(function() part.CanCollide=oldValue end) end
    local hum=LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
    if hum and originalSpeed then hum.WalkSpeed=originalSpeed end
    pcall(function() gui:Destroy() end)
end
if getgenv then getgenv().ZOYA_V2_CLEANUP=cleanup end
notify("ZOYA HUB V2 berhasil dimuat. Masukkan password.")
