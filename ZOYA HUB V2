local function clearHighlight(obj)
    local h=highlights[obj]
    if h then pcall(function() h:Destroy() end) end
    highlights[obj]=nil
end

local function objectKind(obj)
    local n=(obj.Name.." "..obj:GetFullName()):lower()
    if n:find("opah") or n:find("nenek") then return "Opah" end
    if n:find("key") or n:find("kunci") then return "Key" end
    if n:find("code") or n:find("kode") or n:find("password") then return "Code" end
    return nil
end

local function addHighlight(obj, kind)
    if highlights[obj] or not obj:IsDescendantOf(Workspace) then return end
    local adornee=obj
    if not obj:IsA("Model") and not obj:IsA("BasePart") then
        adornee=obj:FindFirstAncestorOfClass("Model") or obj:FindFirstAncestorWhichIsA("BasePart")
    end
    if not adornee then return end
    local h=Instance.new("Highlight")
    h.Name="ZOYA_V2_ESP"
    h.Adornee=adornee
    h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
    h.FillTransparency=0.72
    h.OutlineTransparency=0
    h.FillColor=(kind=="Opah") and selectedColor or (kind=="Key" and Color3.fromRGB(255,220,65) or Color3.fromRGB(70,210,255))
    h.OutlineColor=h.FillColor
    h.Parent=Workspace
    highlights[obj]=h
end

local function playAlert()
    if tick()-lastAlert<4 then return end
    lastAlert=tick()
    pcall(function()
        local sound=Instance.new("Sound")
        sound.SoundId="rbxassetid://9118823101"
        sound.Volume=0.7
        sound.Parent=Workspace
        sound:Play()
        game:GetService("Debris"):AddItem(sound,3)
    end)
    notify("⚠ OPAH DEKAT!","Opah terdeteksi di sekitar kamu!")
end

local function cleanup()
    alive=false
    for _,c in ipairs(connections) do pcall(function() c:Disconnect() end) end
    for obj in pairs(highlights) do clearHighlight(obj) end
    local char=LP.Character
    local hum=char and char:FindFirstChildOfClass("Humanoid")
    if hum then
        if originalWalkSpeed then hum.WalkSpeed=originalWalkSpeed end
        if originalJumpPower then hum.JumpPower=originalJumpPower end
    end
    pcall(function() gui:Destroy() end)
end

if getgenv then getgenv().ZOYA_V2_CLEANUP=cleanup end

track(RunService.Stepped:Connect(function()
    if not alive then return end
    local char=LP.Character
    if char then
        for _,part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                if noclip then
                    if oldCollisions[part] == nil then
                        oldCollisions[part] = part.CanCollide
                    end
                    part.CanCollide = false
                elseif oldCollisions[part] ~= nil then
                    part.CanCollide = oldCollisions[part]
                    oldCollisions[part] = nil
                end
            end
        end
    end
    if char then
        local hum=char:FindFirstChildOfClass("Humanoid")
        if hum then
            if speedEnabled then
                if not originalWalkSpeed then originalWalkSpeed=hum.WalkSpeed end
                hum.WalkSpeed=speedValue
            elseif originalWalkSpeed then
                hum.WalkSpeed=originalWalkSpeed
                originalWalkSpeed=nil
            end
        end
    end
end))

track(RunService.Heartbeat:Connect(function(dt)
    if not alive then return end
    scanClock=scanClock+dt
    if scanClock<1.2 then return end
    scanClock=0

    local myRoot=getRoot(LP.Character)
    local opahNear=false

    for _,obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("BasePart") then
            local kind=objectKind(obj)
            if kind and esp[kind] then
                addHighlight(obj,kind)
            elseif highlights[obj] then
                clearHighlight(obj)
            end

            if kind=="Opah" and myRoot and alertEnabled then
                local targetRoot=getRoot(obj:IsA("Model") and obj or obj:FindFirstAncestorOfClass("Model"))
                if targetRoot and (targetRoot.Position-myRoot.Position).Magnitude<35 then
                    opahNear=true
                end
            end
        end
    end

    if opahNear then playAlert() end

    if esp.Player then
        for _,plr in ipairs(Players:GetPlayers()) do
            if plr~=LP and plr.Character then
                addHighlight(plr.Character,"Player")
            end
        end
    else
        for obj in pairs(highlights) do
            if obj:IsA("Model") and Players:GetPlayerFromCharacter(obj) then
                clearHighlight(obj)
            end
        end
    end

    if rainbow then
        selectedColor=Color3.fromHSV((tick()%5)/5,1,1)
        for obj,h in pairs(highlights) do
            if h and h.Parent and objectKind(obj)=="Opah" then
                h.FillColor=selectedColor
                h.OutlineColor=selectedColor
            end
        end
    end

    if autoKey and typeof(fireproximityprompt)=="function" then
        for _,obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("ProximityPrompt") then
                local parentName=(obj.Parent and obj.Parent:GetFullName() or ""):lower()
                if parentName:find("key") or parentName:find("kunci") then
                    pcall(fireproximityprompt,obj)
                end
            end
        end
    end
end))

