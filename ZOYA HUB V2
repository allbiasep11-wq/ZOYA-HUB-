local dragging, dragInput, dragStart, startPos = false,nil,nil,nil
Header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        local x = input.Position.X - Header.AbsolutePosition.X
        if x < Header.AbsoluteSize.X - 125 then
            dragging = true
            dragInput = input
            dragStart = input.Position
            startPos = Main.Position
        end
    end
end)

connect(UIS.InputChanged,function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input == dragInput) then
        local delta = input.Position - dragStart
        Main.Position = UDim2.new(startPos.X.Scale,startPos.X.Offset+delta.X,startPos.Y.Scale,startPos.Y.Offset+delta.Y)
    end
end)

connect(UIS.InputEnded,function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input == dragInput then
        dragging = false
        dragInput = nil
    end
end)

