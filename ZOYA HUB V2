local function makeToggle(txt,y,initial,fn)
    local state = initial == true
    local b
    b = actionButton(txt.." : "..(state and "ON" or "OFF"),y,function()
        state = not state
        b.Text = txt.." : "..(state and "ON" or "OFF")
        b.BackgroundColor3 = state and Color3.fromRGB(105,55,165) or BUTTON
        fn(state)
    end)
    return b
end

local function hasName(obj,words)
    local name = string.lower(obj.Name)
    for _,word in ipairs(words) do
        if string.find(name,word,1,true) then return true end
    end
    return false
end

local function clearESP(obj)
    local h = highlights[obj]
    if h then
        pcall(function() h:Destroy() end)
        highlights[obj] = nil
    end
end

local function addESP(obj,color,title)
    if not obj or not obj.Parent then return end
    if not (obj:IsA("Model") or obj:IsA("BasePart")) then return end
    if obj:IsA("Model") and not obj:FindFirstChildWhichIsA("BasePart") then return end

    local h = highlights[obj]
    if not h then
        h = Instance.new("Highlight")
        h.Name = "ZOYA_ESP"
        h.Adornee = obj
        h.FillTransparency = 0.72
        h.OutlineTransparency = 0
        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        h.Parent = Workspace
        highlights[obj] = h
    end
    h.FillColor = color
    h.OutlineColor = color

    if title then
        local part = obj:IsA("Model") and (obj:FindFirstChild("Head") or obj:FindFirstChildWhichIsA("BasePart")) or obj
        if part and not part:FindFirstChild("ZOYA_TAG") then
            local bb = Instance.new("BillboardGui")
            bb.Name = "ZOYA_TAG"
            bb.Adornee = part
            bb.Size = UDim2.fromOffset(170,25)
            bb.StudsOffset = Vector3.new(0,3,0)
            bb.AlwaysOnTop = true
            bb.Parent = part

            local label = Instance.new("TextLabel")
            label.Size = UDim2.fromScale(1,1)
            label.BackgroundTransparency = 1
            label.Text = title
            label.TextColor3 = color
            label.TextStrokeTransparency = 0
            label.Font = Enum.Font.GothamBold
            label.TextSize = 12
            label.Parent = bb
        end
    end
end

local function scan()
    for _,obj in ipairs(Workspace:GetDescendants()) do
        if not alive then return end
        if esp.Opah and hasName(obj,{"opah"}) then
            addESP(obj,rainbow and Color3.fromHSV((tick()%5)/5,1,1) or chosenColor,"OPAH")
        elseif esp.Key and hasName(obj,{"key","kunci"}) then
            addESP(obj,Color3.fromRGB(255,220,40),"KEY")
        elseif esp.Code and hasName(obj,{"code","kode","note","paper"}) then
            addESP(obj,Color3.fromRGB(50,220,255),"CODE")
        end
    end

    for _,p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            if esp.Player then
                addESP(p.Character,Color3.fromRGB(80,220,255),"PLAYER: "..p.Name)
            else
                clearESP(p.Character)
            end
        end
    end
end

